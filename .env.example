# Copy to .env (gitignored) and fill in. Every setting has a default; see src/llm_router/config.py.
# The Anthropic SDK reads the key from the environment itself.
ANTHROPIC_API_KEY=

# anthropic | stub (offline placeholder answers, no key needed)
LLM_ROUTER_CLAUDE_BACKEND=anthropic
LLM_ROUTER_SMALL_MODEL=claude-haiku-5-5
LLM_ROUTER_LARGE_MODEL=claude-sonnet-5-5
LLM_ROUTER_DEFAULT_STRATEGY=heuristic
LLM_ROUTER_REDIS_URL=redis://localhost:56379/0
LLM_ROUTER_CACHE_THRESHOLD=0.88
LLM_ROUTER_CACHE_TTL_SECONDS=86400
