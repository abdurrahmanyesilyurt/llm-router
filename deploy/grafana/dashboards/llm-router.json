      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_router_cost_usd_total[$__rate_interval])) / clamp_min(sum(rate(llm_router_requests_total[$__rate_interval])), 1e-9)",
